PORT=4174
NODE_ENV=development
# Keep disabled outside local development. Without this, users must register or sign in.
DEV_DEMO_SESSION=0
# Use a long random secret in every deployed environment.
FILE_SIGNING_SECRET=replace-with-a-long-random-secret
# Supabase project settings. Never expose the service-role key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=student-files
# Configure these to enable the real Solvy provider. Leave unset only for local-intake development fallback.
SOLVY_API_URL=
SOLVY_API_KEY=
DATABASE_URL=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=lkr
EXPLAIN_DAILY_LIMIT=30
