{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix client --include=dev --no-audit --no-fund && npm ci --prefix server --omit=dev --no-audit --no-fund",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "fluid": true,
  "env": {
    "SHOWCASE_MODE": "0",
    "FREE_BETA_MODE": "1",
    "TRUST_PROXY_HOPS": "1"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{client/dist/**,server/migrations/**}"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api?__originalPath=/api" },
    { "source": "/api/:path*", "destination": "/api?__originalPath=/api/:path*" },
    { "source": "/robots.txt", "destination": "/api?__originalPath=/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api?__originalPath=/sitemap.xml" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
